{
  "name": "roundrobin",
  "version": "1.0.0",
  "description": "Free-model router for OpenCode Zen verified free models with automatic exhaustion rotation and Ollama fallback.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "roundrobin": "./dist/cli/index.js",
    "RoundRobin": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobbybacklogs/RoundRobin.git"
  },
  "keywords": [
    "opencode",
    "opencode-zen",
    "free-models",
    "router",
    "round-robin",
    "ollama",
    "llm",
    "ai",
    "openai",
    "proxy"
  ],
  "author": "bobbybacklogs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bobbybacklogs/RoundRobin/issues"
  },
  "homepage": "https://github.com/bobbybacklogs/RoundRobin#readme",
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.18.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
